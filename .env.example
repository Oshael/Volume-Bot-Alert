# ===== Volume Alert Server ??? Environment Config =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Server
PORT=3000
NODE_ENV=development
# Force HTTPS redirect in production behind reverse proxy
FORCE_HTTPS=false

# Runtime roles
RUN_SOCKET_HUB=true
RUN_BACKGROUND_JOBS=true
# all, core, market, maintenance, robinhood, or robinhood-backfill
BACKGROUND_WORKER_GROUPS=all

# Robinhood ingestion/backfill are separate isolated groups and excluded from `all`.
ROBINHOOD_INGESTION_ENABLED=false
ROBINHOOD_MARKET_AGGREGATES_ENABLED=true
# Durable head/processing/derived handoff gates. All ownership/publication gates
# are fail-closed and must be enabled deliberately during the cutover.
ROBINHOOD_DERIVED_OUTBOX_ENABLED=false
ROBINHOOD_PROCESSING_SHADOW_AUDIT_ENABLED=false
ROBINHOOD_DERIVED_SHADOW_AUDIT_ONLY=false
ROBINHOOD_DERIVED_STANDARD_ALERTS_ENABLED=false
ROBINHOOD_DERIVED_STANDARD_ALERTS_PUBLISHABLE=false
ROBINHOOD_DERIVED_LIVE_SINKS_ENABLED=false
ROBINHOOD_DERIVED_REALTIME_ALERTS_ENABLED=false
ROBINHOOD_DERIVED_REALTIME_ALERTS_PUBLISHABLE=false
ROBINHOOD_DERIVED_ALERT_HEALTH_MAX_AGE_MS=90000
ROBINHOOD_MARKET_AGGREGATE_READS_ENABLED=false
ROBINHOOD_MARKET_AGGREGATE_FALLBACK_ENABLED=true
ROBINHOOD_MARKET_AGGREGATE_SHADOW_COMPARE_ENABLED=false
ROBINHOOD_MARKET_AGGREGATE_VERIFIED_FROM=
ROBINHOOD_MARKET_AGGREGATE_VERIFIED_THROUGH=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_USE_ALCHEMY=false
ROBINHOOD_ALCHEMY_RPC_URL=
ROBINHOOD_USE_DRPC=false
ROBINHOOD_DRPC_RPC_URL=
ROBINHOOD_V4_REPLAY_RPC_URL=http://127.0.0.1:8547
ROBINHOOD_V4_REPLAY_RANGE_SIZE=1000
ROBINHOOD_V4_REPLAY_CONFIRMATIONS=2
ROBINHOOD_V4_REPLAY_MAX_RANGES=100000
ROBINHOOD_FALLBACK_ORDER=drpc,alchemy
# Comparative read-only scan probe; does not change ingestion routing or cursors.
ROBINHOOD_BACKFILL_PROBE_TIMEOUT_MS=15000
ROBINHOOD_BACKFILL_PROBE_RANGE_SIZES=1000,5000,10000
ROBINHOOD_BACKFILL_PROBE_IN_FLIGHT=1,2,4
ROBINHOOD_BACKFILL_PROBE_SAMPLES=1
ROBINHOOD_BACKFILL_PROBE_START_BLOCK=
# Durable market backfill shadow. dRPC carries the scan load; disabled is inert.
ROBINHOOD_BACKFILL_SHADOW_ENABLED=false
ROBINHOOD_BACKFILL_DISCOVERY_ENABLED=false
ROBINHOOD_BACKFILL_START_BLOCK=
ROBINHOOD_SCAN_PROVIDER=drpc
ROBINHOOD_DISCOVERY_SCAN_PROVIDER=drpc
ROBINHOOD_DISCOVERY_SCAN_RANGE_SIZE=10000
ROBINHOOD_HEAD_PROVIDER=public
ROBINHOOD_SCAN_RANGE_SIZE=10000
ROBINHOOD_SCAN_MIN_RANGE_SIZE=10
ROBINHOOD_SCAN_IN_FLIGHT_RANGES=1
ROBINHOOD_SCAN_MAX_LOGS_PER_RANGE=10000
ROBINHOOD_SCAN_MAX_BUFFERED_LOGS=50000
ROBINHOOD_SCAN_MAX_PENDING_LOGS=250000
ROBINHOOD_DISCOVERY_SCAN_MAX_RANGES_PER_POLL=4
ROBINHOOD_SCAN_INTERVAL_MS=2000
ROBINHOOD_SCAN_RPC_TIMEOUT_MS=15000
ROBINHOOD_SCAN_RPC_MAX_RETRIES=1
ROBINHOOD_SCAN_RPC_MIN_INTERVAL_MS=0
ROBINHOOD_BACKFILL_DECODER_VERSION=market-log-v1
ROBINHOOD_BACKFILL_DISCOVERY_DECODER_VERSION=discovery-log-v1
# Enrichment and finalization stay inert until explicitly enabled.
# Optional Alchemy use is limited to timestamps; monitor its CU usage externally.
ROBINHOOD_BACKFILL_ENRICHMENT_ENABLED=false
ROBINHOOD_BACKFILL_ALCHEMY_TIMESTAMPS_ENABLED=false
ROBINHOOD_BACKFILL_ENRICHMENT_INTERVAL_MS=2000
ROBINHOOD_BACKFILL_ENRICHMENT_MAX_ERROR_BACKOFF_MS=30000
ROBINHOOD_BACKFILL_ENRICHMENT_CLAIM_SIZE=100
ROBINHOOD_BACKFILL_ENRICHMENT_LEASE_MS=60000
ROBINHOOD_BACKFILL_ENRICHMENT_RETRY_DELAY_MS=5000
ROBINHOOD_BACKFILL_ENRICHMENT_MAX_ATTEMPTS=5
ROBINHOOD_ENRICHMENT_RPC_MIN_INTERVAL_MS=0
ROBINHOOD_RPC_BATCH_SIZE=100
ROBINHOOD_BACKFILL_FINALIZER_ENABLED=false
ROBINHOOD_BACKFILL_FINALIZER_INTERVAL_MS=2000
ROBINHOOD_BACKFILL_FINALIZER_MAX_ERROR_BACKOFF_MS=30000
ROBINHOOD_BACKFILL_FINALIZER_RANGE_LIMIT=100
ROBINHOOD_SOCIAL_METADATA_ENABLED=false
ROBINHOOD_POLL_INTERVAL_MS=2000
ROBINHOOD_LOOKBACK_BLOCKS=250
# Required on first persistent bootstrap; DB cursors override it after both streams commit.
ROBINHOOD_START_BLOCK=
ROBINHOOD_DISCOVERY_BOOTSTRAP_START_BLOCK=
ROBINHOOD_DISCOVERY_BOOTSTRAP_RANGE_SIZE=250
ROBINHOOD_DISCOVERY_BOOTSTRAP_MIN_RANGE_SIZE=1
ROBINHOOD_DISCOVERY_BOOTSTRAP_MAX_RANGE_SIZE=2000
ROBINHOOD_DISCOVERY_BOOTSTRAP_MAX_RANGES=100
ROBINHOOD_DISCOVERY_BOOTSTRAP_USE_ALCHEMY=false
# Alchemy Free eth_getBlockByNumber costs 20 CU; 50ms keeps sustained use near 400 CU/s.
ROBINHOOD_DISCOVERY_BOOTSTRAP_ALCHEMY_MIN_INTERVAL_MS=50
ROBINHOOD_CONFIRMATIONS=2
ROBINHOOD_RPC_MIN_INTERVAL_MS=250
ROBINHOOD_ARCHIVE_RPC_MIN_INTERVAL_MS=250
ROBINHOOD_RANGE_SIZE=10
ROBINHOOD_MIN_RANGE_SIZE=1
ROBINHOOD_MAX_RANGE_SIZE=100
ROBINHOOD_MAX_RANGES_PER_POLL=20
ROBINHOOD_MAX_ADDRESSES_PER_LOG_REQUEST=100
# topics-only avoids one eth_getLogs shard per 100 registered pool addresses.
ROBINHOOD_MARKET_LOG_FILTER_MODE=topics-only
ROBINHOOD_TIMESTAMP_CONCURRENCY=16
ROBINHOOD_OBSERVATION_CONCURRENCY=1
ROBINHOOD_CATALOG_PROJECTION_INTERVAL_MS=60000
ROBINHOOD_CATALOG_PROJECTION_MAX_TOKENS=50
ROBINHOOD_CATALOG_PROJECTION_CONCURRENCY=8
ROBINHOOD_BLOCKSCOUT_METADATA_BATCH_SIZE=50

# Robinhood aggregate signal/publication gates. The global volume floor limits
# candidate reads; each user's hvnc-min-vol can further tighten publication.
ROBINHOOD_SIGNAL_DRY_RUN_ENABLED=true
ROBINHOOD_SIGNAL_PROTOCOLS=uniswap-v2
ROBINHOOD_SIGNAL_WINDOW_MS=300000
ROBINHOOD_SIGNAL_MIN_LIQUIDITY_USD=3000
ROBINHOOD_SIGNAL_MIN_VOLUME_USD=100000
ROBINHOOD_SIGNAL_MIN_TRANSACTIONS=10
ROBINHOOD_SIGNAL_MAX_AGE_MS=300000
ROBINHOOD_SIGNAL_CANDIDATE_LIMIT=5000
ROBINHOOD_SIGNAL_SAMPLE_LIMIT=25
ROBINHOOD_SIGNAL_STATEMENT_TIMEOUT_MS=10000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volume_alert
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT ??? generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MARKET_TICKER_RATE_LIMIT_WINDOW_MS=900000
MARKET_TICKER_RATE_LIMIT_MAX_REQUESTS=240
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
AUTH_EMAIL_RATE_LIMIT_MAX_REQUESTS=6
AUTH_OTP_RATE_LIMIT_WINDOW_MS=900000
AUTH_OTP_RATE_LIMIT_MAX_REQUESTS=12

# Invite System
INVITE_EXPIRY_HOURS=72
INVITE_MAX_USES=1

# Frontend Solana wallet selector. Keep this network aligned with the token gate mint/RPC.
VITE_SOLANA_NETWORK=mainnet
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Token-gated wallet access / holder discounts
TOKEN_GATE_ENABLED=false
TOKEN_GATE_CHAIN=solana
TOKEN_GATE_MINT_ADDRESS=
TOKEN_GATE_RPC_PROVIDER=helius
TOKEN_GATE_BALANCE_CACHE_SECONDS=60
TOKEN_GATE_RPC_FAILURE_GRACE_SECONDS=3600
TOKEN_GATE_UNLIMITED_THRESHOLD=2000000
# Legacy single discount fallback. Ignored when TOKEN_GATE_DISCOUNT_TIERS_JSON has entries.
TOKEN_GATE_DISCOUNT_THRESHOLD=1000000
TOKEN_GATE_DISCOUNT_PERCENT=50
# Example tiers: 250k = Tier 3, 500k = Tier 2, 1M = Tier 1, 2M = Tier Premium/unlimited.
TOKEN_GATE_DISCOUNT_TIERS_JSON=[{"threshold":"250000","discountPercent":10},{"threshold":"500000","discountPercent":25},{"threshold":"1000000","discountPercent":50}]
TOKEN_GATE_LAUNCH_PROMO_ENABLED=true
TOKEN_GATE_LAUNCH_PROMO_START_AT=
TOKEN_GATE_LAUNCH_PROMO_END_AT=
TOKEN_GATE_LAUNCH_PROMO_THRESHOLD=100000
HELIUS_WEBHOOK_TOKENS=
HELIUS_TOKEN_GATE_WEBHOOK_SYNC_ENABLED=false
HELIUS_TOKEN_GATE_WEBHOOK_ID=
HELIUS_TOKEN_GATE_WEBHOOK_URL=
HELIUS_TOKEN_GATE_WEBHOOK_TRANSACTION_TYPES=TRANSFER
HELIUS_WEBHOOK_API_BASE_URL=https://mainnet.helius-rpc.com
HELIUS_API_KEY=

# Email / transactional mail
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=TrendScope <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=30
LOGIN_OTP_EXPIRES_MINUTES=10
LOGIN_OTP_LENGTH=6
LOGIN_OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=
EMAIL_DEV_CAPTURE=true
EMAIL_DEV_FALLBACK_ON_FAILURE=true
EMAIL_DEV_EXPOSE_DEBUG=true

# Telegram alerts. Keep disabled until the bot, webhook, schema, and workers are ready.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=
TELEGRAM_DELIVERY_BATCH_SIZE=25
TELEGRAM_DELIVERY_CONCURRENCY=4
TELEGRAM_DELIVERY_INTERVAL_MS=1000
TELEGRAM_DELIVERY_MAX_BACKOFF_MS=30000
TELEGRAM_DELIVERY_LEASE_MS=60000
TELEGRAM_DELIVERY_RENEWAL_INTERVAL_MS=30000
TELEGRAM_DELIVERY_TIMEOUT_MS=10000
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_REACTIVATION_BATCH_SIZE=100
TELEGRAM_SPARKLINE_HOURS=24
TELEGRAM_SPARKLINE_GRANULARITY_MINUTES=5

# CORS ??? comma-separated origins allowed
CORS_ORIGINS=http://localhost:3000

# Socket security limits
SOCKET_MAX_CONNECTIONS_PER_IP=12
SOCKET_MAX_SOCKETS_PER_SESSION=4
SOCKET_MAX_SUBSCRIPTIONS_PER_SOCKET=350
SOCKET_MAX_HTTP_BUFFER_SIZE=65536
SOCKET_MAX_ACTIONS_PER_WINDOW=180

# Heavy analytics workers. Keep run-on-start disabled on small VPS instances.
BID_ZONE_WORKER_ENABLED=false
BID_ZONE_WORKER_RUN_ON_START=false
BID_ZONE_STATEMENT_TIMEOUT_MS=15000
BID_ZONE_CANDIDATE_SCAN_LIMIT=400
PUMPFUN_META_RATE_LIMIT_MAX_REQUESTS=300

# Catalog worker distributed claim. Keep disabled until multi-catalog-worker validation is complete.
CATALOG_WORKER_DISTRIBUTED_CLAIM_ENABLED=false
CATALOG_WORKER_DISTRIBUTED_CLAIM_TTL_MS=120000

# GMGN discovery / volume alerts
# Keep disabled until GMGN_API_KEY is configured and db-init-stage17/stage36 have run.
GMGN_DISCOVERY_ENABLED=false
GMGN_API_KEY=
GMGN_CLI_BIN=gmgn-cli
GMGN_CLI_TIMEOUT_MS=10000
GMGN_DISCOVERY_INTERVAL_MS=2000
GMGN_REQUESTS_PER_WINDOW=2
GMGN_REQUEST_WINDOW_MS=2000
GMGN_TRENDING_LIMIT=30
GMGN_PANEL_STALE_AFTER_MS=15000
GMGN_ACTIVE_DEX_RECHECK_MS=30000
GMGN_ALERT_EVALUATION_MIN_INTERVAL_MS=3000
GMGN_VOL_1M_ALERT_ENABLED=false
GMGN_VOL_1M_ALERT_THRESHOLD_PCT=50
GMGN_VOL_1M_ALERT_COOLDOWN_MS=60000
GMGN_VOL_1M_REPEAT_STEP_PCT=50
GMGN_BACKOFF_MIN_MS=5000
GMGN_BACKOFF_MAX_MS=60000

# CoinGecko Demo API experiments. Keep backend-only; do not expose this in frontend env.
COINGECKO_DEMO_API_KEY=
COINGECKO_REQUEST_DELAY_MS=800
COINGECKO_REQUEST_TIMEOUT_MS=15000

# GMGN Pump/Bags claim signal alerts
# Enabled by default. Set false only if you want to disable it.
GMGN_CLAIM_SIGNAL_ENABLED=true
GMGN_CLAIM_SIGNAL_INTERVAL_MS=60000
GMGN_CLAIM_SIGNAL_CHAIN=sol
GMGN_CLAIM_SIGNAL_TYPES=17,18
GMGN_CLAIM_SIGNAL_MAX_ALERTS_PER_TOKEN=2

# Billing / MoonPay Commerce
# BILLING_PLANS_JSON example:
# [{"key":"plan-30d","label":"30 Days","description":"Monthly access","accessDays":30,"currencyCode":"USDC","amountMinor":1500,"featured":true,"providerPaylinkId":"your_dynamic_paylink_id","providerPaylinkDynamic":true}]
BILLING_ENABLED=false
BILLING_CHECKOUT_RETURN_URL=http://localhost:5173/access
BILLING_PLANS_JSON=[]
# Mainnet: https://api.hel.io/v1
# Sandbox/testnet: https://api.dev.hel.io/v1
# Leave blank to follow MOONPAY_COMMERCE_NETWORK automatically.
MOONPAY_COMMERCE_API_BASE_URL=
MOONPAY_COMMERCE_API_KEY=
MOONPAY_COMMERCE_BEARER_TOKEN=
MOONPAY_COMMERCE_WEBHOOK_TOKENS=
MOONPAY_COMMERCE_NETWORK=main
MOONPAY_COMMERCE_MOCK_MODE=false
