# ===== Volume Alert Server ??? Environment Config =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Server
PORT=3000
NODE_ENV=development
# Force HTTPS redirect in production behind reverse proxy
FORCE_HTTPS=false

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volume_alert
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT ??? generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
AUTH_EMAIL_RATE_LIMIT_MAX_REQUESTS=6
AUTH_OTP_RATE_LIMIT_WINDOW_MS=900000
AUTH_OTP_RATE_LIMIT_MAX_REQUESTS=12

# Invite System
INVITE_EXPIRY_HOURS=72
INVITE_MAX_USES=1

# Email / transactional mail
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=TrendScope <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=30
LOGIN_OTP_EXPIRES_MINUTES=10
LOGIN_OTP_LENGTH=6
LOGIN_OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=
EMAIL_DEV_CAPTURE=true
EMAIL_DEV_FALLBACK_ON_FAILURE=true
EMAIL_DEV_EXPOSE_DEBUG=true

# CORS ??? comma-separated origins allowed
CORS_ORIGINS=http://localhost:3000

# Socket security limits
SOCKET_MAX_CONNECTIONS_PER_IP=12
SOCKET_MAX_SOCKETS_PER_SESSION=4
SOCKET_MAX_SUBSCRIPTIONS_PER_SOCKET=350
SOCKET_MAX_ACTIONS_PER_WINDOW=180

# Heavy analytics workers. Keep run-on-start disabled on small VPS instances.
BID_ZONE_WORKER_ENABLED=false
BID_ZONE_WORKER_RUN_ON_START=false
BID_ZONE_STATEMENT_TIMEOUT_MS=15000
BID_ZONE_CANDIDATE_SCAN_LIMIT=400
PUMPFUN_META_RATE_LIMIT_MAX_REQUESTS=300

# GMGN discovery / volume alerts
# Keep disabled until GMGN_API_KEY is configured and db-init-stage17/stage36 have run.
GMGN_DISCOVERY_ENABLED=false
GMGN_API_KEY=
GMGN_CLI_BIN=gmgn-cli
GMGN_CLI_TIMEOUT_MS=10000
GMGN_DISCOVERY_INTERVAL_MS=2000
GMGN_REQUESTS_PER_WINDOW=2
GMGN_REQUEST_WINDOW_MS=2000
GMGN_TRENDING_LIMIT=30
GMGN_PANEL_STALE_AFTER_MS=15000
GMGN_ACTIVE_DEX_RECHECK_MS=30000
GMGN_ALERT_EVALUATION_MIN_INTERVAL_MS=3000
GMGN_VOL_1M_ALERT_ENABLED=false
GMGN_VOL_1M_ALERT_THRESHOLD_PCT=50
GMGN_VOL_1M_ALERT_COOLDOWN_MS=60000
GMGN_VOL_1M_REPEAT_STEP_PCT=50
GMGN_BACKOFF_MIN_MS=5000
GMGN_BACKOFF_MAX_MS=60000

# GMGN Pump/Bags claim signal alerts
# Enabled by default. Set false only if you want to disable it.
GMGN_CLAIM_SIGNAL_ENABLED=true
GMGN_CLAIM_SIGNAL_INTERVAL_MS=60000
GMGN_CLAIM_SIGNAL_CHAIN=sol
GMGN_CLAIM_SIGNAL_TYPES=17,18
GMGN_CLAIM_SIGNAL_MAX_ALERTS_PER_TOKEN=2

# Billing / MoonPay Commerce
# BILLING_PLANS_JSON example:
# [{"key":"plan-7d","label":"7 Days","description":"Weekly access","accessDays":7,"currencyCode":"USDC","amountMinor":1500,"featured":true,"providerPaylinkId":"your_paylink_id"}]
BILLING_ENABLED=false
BILLING_CHECKOUT_RETURN_URL=http://localhost:5173/access
BILLING_PLANS_JSON=[]
# Mainnet: https://api.hel.io/v1
# Sandbox/testnet: https://api.dev.hel.io/v1
# Leave blank to follow MOONPAY_COMMERCE_NETWORK automatically.
MOONPAY_COMMERCE_API_BASE_URL=
MOONPAY_COMMERCE_API_KEY=
MOONPAY_COMMERCE_BEARER_TOKEN=
MOONPAY_COMMERCE_WEBHOOK_TOKENS=
MOONPAY_COMMERCE_NETWORK=main
MOONPAY_COMMERCE_MOCK_MODE=false
