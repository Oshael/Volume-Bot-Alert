# ===== Volume Alert Server ??? Environment Config =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Server
PORT=3000
NODE_ENV=development
# Force HTTPS redirect in production behind reverse proxy
FORCE_HTTPS=false

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volume_alert
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT ??? generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
AUTH_EMAIL_RATE_LIMIT_MAX_REQUESTS=6
AUTH_OTP_RATE_LIMIT_WINDOW_MS=900000
AUTH_OTP_RATE_LIMIT_MAX_REQUESTS=12

# Invite System
INVITE_EXPIRY_HOURS=72
INVITE_MAX_USES=1

# Email / transactional mail
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=TrendScope <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=30
LOGIN_OTP_EXPIRES_MINUTES=10
LOGIN_OTP_LENGTH=6
LOGIN_OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=

# CORS ??? comma-separated origins allowed
CORS_ORIGINS=http://localhost:3000
