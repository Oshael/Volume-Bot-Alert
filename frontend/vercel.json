{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/login/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/access",
      "destination": "/index.html"
    },
    {
      "source": "/access/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/account-security",
      "destination": "/index.html"
    },
    {
      "source": "/account-security/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/alerts",
      "destination": "/index.html"
    },
    {
      "source": "/alerts/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/monitor",
      "destination": "/index.html"
    },
    {
      "source": "/monitor/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/workspace/:path*",
      "destination": "/index.html"
    }
  ]
}
