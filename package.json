    "robinhood:discovery-bootstrap": "node src/utils/robinhood-discovery-bootstrap.js",
    "robinhood:wallet-live-bootstrap": "node src/utils/bootstrap-robinhood-wallet-swap-live.js",
    "robinhood:signal-dry-run": "node src/utils/robinhood-signal-dry-run.js",
    "robinhood:creator-backfill": "node src/utils/backfill-robinhood-token-creators.js",
    "robinhood:launchpad-creator-backfill": "node src/utils/backfill-robinhood-launchpad-creators.js",
    "robinhood:aggregates:backfill": "node src/utils/backfill-robinhood-market-aggregates.js",
