    "dev:worker:core": "PORT=${PORT:-3001} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=core node --watch src/server.js",
    "dev:worker:market": "PORT=${PORT:-3002} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=market node --watch src/server.js",
    "dev:worker:solana-maintenance": "PORT=${PORT:-3003} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=solana-maintenance node --watch src/server.js",
    "dev:worker:robinhood-maintenance": "PORT=${PORT:-3011} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood-maintenance node --watch src/server.js",
