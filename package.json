    "test:all": "npm run test:unit && npm run test:integration",
    "test:core": "npm run test:integration",
    "test:admin": "NODE_ENV=test node --test --test-force-exit tests/admin.test.js",
    "test:auth": "NODE_ENV=test node --test --test-force-exit tests/auth.test.js",
    "test:catalog": "NODE_ENV=test node --test --test-force-exit tests/catalog.test.js",
    "test:config": "NODE_ENV=test node --test --test-force-exit tests/config.test.js",
    "test:billing": "NODE_ENV=test node --test --test-force-exit tests/billing.test.js",
    "test:dashboard": "NODE_ENV=test node --test --test-force-exit tests/dashboard.test.js",
    "test:mock-trading-routes": "NODE_ENV=test node --test --test-force-exit tests/mock-trading-routes.test.js",
    "test:smoke": "playwright test",
