{
  "name": "volume-alert-server",
  "version": "1.0.0",
  "description": "Volume Alert Bot — Backend Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:web": "RUN_SOCKET_HUB=true RUN_BACKGROUND_JOBS=false node src/server.js",
    "start:worker": "RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:web": "RUN_SOCKET_HUB=true RUN_BACKGROUND_JOBS=false node --watch src/server.js",
    "dev:worker": "RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:core",
    "test:core": "npm run db:schema-check:test && npm run test:admin && npm run test:auth && npm run test:catalog && npm run test:config && npm run test:billing",
    "test:admin": "node --test --test-force-exit tests/admin.test.js",
    "test:auth": "node --test --test-force-exit tests/auth.test.js",
    "test:catalog": "node --test --test-force-exit tests/catalog.test.js",
    "test:config": "node --test --test-force-exit tests/config.test.js",
    "test:billing": "node --test --test-force-exit tests/billing.test.js",
    "test:smoke": "playwright test",
    "db:init": "node src/utils/db-init.js",
    "db:schema-check": "node src/utils/check-runtime-schema.js",
    "db:schema-check:test": "NODE_ENV=test node src/utils/check-runtime-schema.js --test-profile",
    "market-buckets:backfill": "node src/utils/backfill-market-buckets-1m.js",
    "market-volume-buckets:backfill": "node src/utils/backfill-market-volume-buckets-1m.js",
    "market-snapshots:drop": "node src/utils/drop-market-snapshots.js --confirm-drop",
    "token-junk:collect": "node src/utils/collect-token-junk-samples.js",
    "token-junk:normalize": "node src/utils/normalize-token-junk-dataset.js",
    "invite:create": "node src/utils/create-invite.js",
    "lateralization:debug": "node src/utils/debug-lateralization.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.58.0"
  }
}
