    "dev:worker:robinhood-processing": "PORT=${PORT:-3007} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood-processing node --watch src/server.js",
    "dev:worker:robinhood-derived": "PORT=${PORT:-3008} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood-derived node --watch src/server.js",
    "dev:worker:robinhood-backfill": "PORT=${PORT:-3005} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood-backfill node --watch src/server.js",
