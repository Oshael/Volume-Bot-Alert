  "description": "Volume Alert Bot — Backend Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:web": "RUN_SOCKET_HUB=true RUN_BACKGROUND_JOBS=false node src/server.js",
    "start:worker": "PORT=${PORT:-3001} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true node src/server.js",
    "start:worker:core": "PORT=${PORT:-3001} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=core node src/server.js",
    "start:worker:market": "PORT=${PORT:-3002} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=market node src/server.js",
    "start:worker:solana-maintenance": "PORT=${PORT:-3003} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=solana-maintenance node src/server.js",
    "start:worker:robinhood-maintenance": "PORT=${PORT:-3011} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood-maintenance node src/server.js",
    "start:worker:maintenance": "PORT=${PORT:-3003} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=maintenance node src/server.js",
    "start:worker:robinhood": "PORT=${PORT:-3004} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood ROBINHOOD_INGESTION_ENABLED=true node src/server.js",
    "start:worker:robinhood-head": "PORT=${PORT:-3006} RUN_SOCKET_HUB=false RUN_BACKGROUND_JOBS=true BACKGROUND_WORKER_GROUPS=robinhood-head ROBINHOOD_INGESTION_ENABLED=true node src/server.js",
