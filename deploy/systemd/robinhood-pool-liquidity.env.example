# Install as /etc/trendscope/robinhood-liquidity.env, replace REPLACE_* values,
# keep root:root mode 0600, and never commit the populated file.

ROBINHOOD_POOL_LIQUIDITY_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=volume_alert
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_SSL=REPLACE_TRUE_OR_FALSE
DB_POOL_MAX=5

ROBINHOOD_RPC_URL=REPLACE_ROBINHOOD_RPC_URL

# Event-driven poller. Do not set ROBINHOOD_POOL_LIQUIDITY_START_BLOCK after
# running the canonical seed; the durable cursor created by the seed owns it.
ROBINHOOD_POOL_LIQUIDITY_POLL_INTERVAL_MS=2000
ROBINHOOD_POOL_LIQUIDITY_MAX_POLL_INTERVAL_MS=15000
ROBINHOOD_POOL_LIQUIDITY_CONFIRMATIONS=2
ROBINHOOD_POOL_LIQUIDITY_RANGE_SIZE=10
ROBINHOOD_POOL_LIQUIDITY_MIN_RANGE_SIZE=1
ROBINHOOD_POOL_LIQUIDITY_MAX_RANGE_SIZE=100
ROBINHOOD_POOL_LIQUIDITY_MAX_RANGES_PER_POLL=20
ROBINHOOD_POOL_LIQUIDITY_REORG_DEPTH=12
ROBINHOOD_POOL_LIQUIDITY_CONCURRENCY=5
ROBINHOOD_POOL_LIQUIDITY_LEASE_HEARTBEAT_MS=30000
ROBINHOOD_POOL_LIQUIDITY_LEASE_TTL_MS=120000
