# Install as /etc/trendscope/callouts.env, keep root:root mode 0600, and never
# commit the populated file. Database/JWT_SECRET remain in the project global .env.

CALLOUT_CAPTURE_ENABLED=true

# Browser CDP reuses the authenticated Chrome session and makes no direct Fomo
# HTTP/WS requests from Node. Keep the endpoint loopback-only.
FOMO_CAPTURE_TRANSPORT=browser_cdp
FOMO_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222

# External account writes are doubly gated and allowlist-only. Start with one
# measured profile in dry-run; never enable automatic unfollow.
FOMO_FOLLOW_ENABLED=false
FOMO_FOLLOW_DRY_RUN=true
# Opt-in Top Profits 24h discovery; still obeys dry-run and max-per-run.
FOMO_FOLLOW_DISCOVERY_ENABLED=false
FOMO_FOLLOW_DISCOVERY_LIMIT=25
FOMO_FOLLOW_PROFILE_IDS=
FOMO_FOLLOW_MAX_PER_RUN=1
FOMO_FOLLOW_DELAY_SECONDS=8
FOMO_FOLLOW_AUTH_WAIT_SECONDS=60
FOMO_FOLLOW_REQUEST_TIMEOUT_SECONDS=15
# Private outbound-only Telegram alert; no webhook is required.
FOMO_FOLLOW_TELEGRAM_ALERTS_ENABLED=false
FOMO_FOLLOW_TELEGRAM_BOT_TOKEN=
FOMO_FOLLOW_TELEGRAM_CHAT_ID=
FOMO_FOLLOW_TELEGRAM_TIMEOUT_SECONDS=10

# Pump is read-only. The direct_ws Fomo transport below is the fallback mode;
# its files must be writable by the service for atomic renewal.
PUMP_AUTH_TOKEN_FILE=/etc/trendscope/secrets/callouts-pump-token
FOMO_WS_JWT_FILE=/var/lib/trendscope/callouts/fomo-customer-token
FOMO_PRIVY_REFRESH_TOKEN_FILE=/var/lib/trendscope/callouts/fomo-refresh-token
FOMO_PRIVY_CA_ID=REPLACE_WITH_PRIVY_CAID_FROM_LOCAL_STORAGE
FOMO_WS_TOPIC_ID=REPLACE_WITH_MEASURED_TOPIC_ID
FOMO_WS_URL=wss://prod-api.fomo.family/ws
FOMO_WS_ORIGIN=https://fomo.family

# Conservative initial cadence.
PUMP_CAPTURE_ACTIVITY_SECONDS=60
PUMP_CAPTURE_LEADERBOARD_SECONDS=900
PUMP_CAPTURE_USERS_PER_ROUND=5
PUMP_CAPTURE_USER_PAGES=2
PUMP_CAPTURE_DEADLINE_SECONDS=45
FOMO_CAPTURE_RECONCILE_SECONDS=900
FOMO_CAPTURE_TRADE_LOOKUP_LIMIT=10
FOMO_CAPTURE_THRESHOLD=1000

# Delete only expired callout_events; profiles and wallet observations are permanent.
CALLOUT_RETENTION_ENABLED=true
CALLOUT_RETENTION_INTERVAL_SECONDS=300
CALLOUT_RETENTION_BATCH_LIMIT=1000
CALLOUT_RETENTION_MAX_BATCHES=5
CALLOUT_RETENTION_MAX_BACKOFF_SECONDS=1800
