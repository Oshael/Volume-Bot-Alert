# Install as /etc/trendscope/robinhood-signed-origin.env, keep root:root mode
# 0600, and never commit the populated file. Database and ROBINHOOD_RPC_URL
# continue to come from the project's existing global .env.

# Requires a completed Stage 181/182 seed cursor. Keep source=rpc for validation;
# after an approved canary, canonical_journal reads committed capture data only.
ROBINHOOD_SIGNED_ORIGIN_LIVE_ENABLED=true
ROBINHOOD_SIGNED_ORIGIN_LIVE_SOURCE=rpc
ROBINHOOD_SIGNED_ORIGIN_LIVE_CONFIRMATIONS=2
ROBINHOOD_SIGNED_ORIGIN_LIVE_INTERVAL_MS=2000
ROBINHOOD_SIGNED_ORIGIN_LIVE_MAX_ERROR_BACKOFF_MS=60000
ROBINHOOD_SIGNED_ORIGIN_LIVE_MAX_BLOCKS_PER_TICK=200
ROBINHOOD_SIGNED_ORIGIN_LIVE_RPC_BATCH_SIZE=20
ROBINHOOD_SIGNED_ORIGIN_LIVE_CONCURRENCY=4
ROBINHOOD_SIGNED_ORIGIN_LIVE_TIMEOUT_MS=15000
ROBINHOOD_SIGNED_ORIGIN_LIVE_CIRCUIT_FAILURE_THRESHOLD=5
ROBINHOOD_SIGNED_ORIGIN_LIVE_CIRCUIT_RESET_MS=60000

# Defense in depth: this isolated process owns no ingestion or publication.
ROBINHOOD_INGESTION_ENABLED=false
ROBINHOOD_TRANSPORT_ENABLED=false
ROBINHOOD_PERSISTENCE_ENABLED=false
ROBINHOOD_ALERTS_ENABLED=false
ROBINHOOD_USER_VISIBILITY_ENABLED=false
