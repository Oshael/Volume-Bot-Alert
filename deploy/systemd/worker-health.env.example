# Install as /etc/trendscope/worker-health.env, replace REPLACE_* values,
# keep root:root mode 0600, and never commit the populated file.

WORKER_HEALTH_MONITOR_ENABLED=true
WORKER_HEALTH_EXPECTED_COMPONENTS=
WORKER_HEALTH_TELEGRAM_BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
WORKER_HEALTH_TELEGRAM_CHAT_ID=REPLACE_TELEGRAM_CHAT_ID
WORKER_HEALTH_TELEGRAM_TIMEOUT_SECONDS=10

# This process runs sequential probes and does not need the application pool size.
DB_POOL_MAX=3

WORKER_HEALTH_INTERVAL_SECONDS=30
WORKER_HEALTH_MIN_OBSERVATIONS=2
WORKER_HEALTH_COOLDOWN_MINUTES=60
WORKER_HEALTH_RETRY_SECONDS=30
WORKER_HEALTH_DB_LATENCY_MS=2000
WORKER_HEALTH_DB_POOL_WAITING=2
WORKER_HEALTH_DB_POOL_PERCENT=90
WORKER_HEALTH_DB_LONG_TX_SECONDS=300
WORKER_HEALTH_WAL_MB_PER_MINUTE=1024
WORKER_HEALTH_MAX_RSS_MB=1536
WORKER_HEALTH_MAX_HEAP_PERCENT=90
WORKER_HEALTH_EVENT_LOOP_P99_MS=500
WORKER_HEALTH_MIN_DISK_FREE_PERCENT=5
WORKER_HEALTH_MIN_DISK_FREE_GB=5
