[Unit]
Description=Trendscope Solana maintenance worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_APP_USER
Group=REPLACE_APP_GROUP
WorkingDirectory=/REPLACE/ABSOLUTE/PATH/Volume-Bot-Alert
Environment=NODE_ENV=production
EnvironmentFile=/etc/volume-bot-alert/solana-maintenance.env
ExecStart=/REPLACE/ABSOLUTE/PATH/TO/node src/server.js
Restart=always
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
