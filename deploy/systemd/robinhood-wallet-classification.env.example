# Install as /etc/trendscope/robinhood-wallet-classification.env, replace the run id,
# keep root:root mode 0600, and never commit the populated file. Database and
# application secrets continue to come from the project's existing global .env.

# Stage 152 must point at a completed Stage 151 first-buy seed campaign.
ROBINHOOD_FIRST_BUY_LIVE_ENABLED=true
ROBINHOOD_FIRST_BUY_SEED_RUN_ID=REPLACE_WITH_COMPLETED_RUN_ID
ROBINHOOD_FIRST_BUY_LIVE_INTERVAL_MS=2000
ROBINHOOD_FIRST_BUY_LIVE_MAX_ERROR_BACKOFF_MS=30000
ROBINHOOD_FIRST_BUY_LIVE_RANGE_SECONDS=300

# PostgreSQL-only anchor projection, fed durably by committed first-buy facts.
ROBINHOOD_LAUNCH_ANCHOR_LIVE_ENABLED=false
ROBINHOOD_LAUNCH_ANCHOR_LIVE_INTERVAL_MS=1000
ROBINHOOD_LAUNCH_ANCHOR_LIVE_RETRY_MS=15000
ROBINHOOD_LAUNCH_ANCHOR_LIVE_MAX_RETRY_MS=3600000
ROBINHOOD_LAUNCH_ANCHOR_LIVE_TIMEOUT_MS=120000

# Conservative SNIPER shadow canary. Public holders/UI remain unable to see it.
ROBINHOOD_SNIPER_SHADOW_ENABLED=true
ROBINHOOD_SNIPER_SHADOW_INTERVAL_MS=10000
ROBINHOOD_SNIPER_SHADOW_MAX_ERROR_BACKOFF_MS=300000
ROBINHOOD_SNIPER_SHADOW_BATCH_SIZE=10
ROBINHOOD_SNIPER_SHADOW_CONCURRENCY=1
ROBINHOOD_SNIPER_SHADOW_RETRY_MS=3600000

# Near-real-time exact deployment attribution for newly admitted catalog tokens.
ROBINHOOD_TOKEN_DEPLOYMENT_LIVE_ENABLED=false
ROBINHOOD_TOKEN_DEPLOYMENT_LIVE_INTERVAL_MS=1000
ROBINHOOD_TOKEN_DEPLOYMENT_LIVE_RETRY_MS=15000
ROBINHOOD_TOKEN_DEPLOYMENT_LIVE_MAX_RETRY_MS=3600000

# Direct creator-distribution INSIDER materialization remains shadow-only.
ROBINHOOD_INSIDER_SHADOW_ENABLED=false
ROBINHOOD_INSIDER_SHADOW_INTERVAL_MS=10000
ROBINHOOD_INSIDER_SHADOW_MAX_ERROR_BACKOFF_MS=300000
ROBINHOOD_INSIDER_SHADOW_BATCH_SIZE=10
ROBINHOOD_INSIDER_SHADOW_CONCURRENCY=1
ROBINHOOD_INSIDER_SHADOW_RETRY_MS=3600000

# Independent responsibilities in this process stay disabled until their own rollout.
ROBINHOOD_WALLET_POSITION_LIVE_ENABLED=false
ROBINHOOD_WALLET_TRANSFER_LIVE_ENABLED=false

# Defense in depth: ingestion and publication do not belong to this process.
ROBINHOOD_INGESTION_ENABLED=false
ROBINHOOD_TRANSPORT_ENABLED=false
ROBINHOOD_PERSISTENCE_ENABLED=false
ROBINHOOD_ALERTS_ENABLED=false
ROBINHOOD_USER_VISIBILITY_ENABLED=false
