# Install as /etc/trendscope/robinhood-wallet-transfers.env, keep root:root mode 0600.
# Database, RPC URLs and secrets continue to come from the project's global .env.

ROBINHOOD_WALLET_TRANSFER_LIVE_ENABLED=true
ROBINHOOD_WALLET_TRANSFER_LIVE_SOURCE=canonical_journal
ROBINHOOD_WALLET_TRANSFER_LIVE_INTERVAL_MS=2000
ROBINHOOD_WALLET_TRANSFER_LIVE_MAX_ERROR_BACKOFF_MS=30000
# Canonical journal accepts up to 5000; RPC mode remains capped at 250.
ROBINHOOD_WALLET_TRANSFER_LIVE_MAX_BLOCKS_PER_TICK=25
ROBINHOOD_WALLET_TRANSFER_ADDRESS_SHARD_CONCURRENCY=1
ROBINHOOD_WALLET_TRANSFER_BLOCK_BATCH_SIZE=50
ROBINHOOD_WALLET_TRANSFER_ROLE_BATCH_SIZE=50
ROBINHOOD_WALLET_UNIFIED_POSITION_LIVE_ENABLED=false
