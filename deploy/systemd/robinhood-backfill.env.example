# Copy to /etc/volume-bot-alert/robinhood-backfill.env, replace every
# REPLACE_* value, keep mode 0600, and never commit the populated file.

PORT=3005
RUN_SOCKET_HUB=false
RUN_BACKGROUND_JOBS=true
BACKGROUND_WORKER_GROUPS=robinhood-backfill

JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET
DATABASE_URL=REPLACE_WITH_PRIVATE_POSTGRESQL_URL

# Defense in depth: this isolated group cannot start legacy ingestion.
ROBINHOOD_INGESTION_ENABLED=false
ROBINHOOD_TRANSPORT_ENABLED=false
ROBINHOOD_PERSISTENCE_ENABLED=false
ROBINHOOD_ALERTS_ENABLED=false
ROBINHOOD_USER_VISIBILITY_ENABLED=false

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_DRPC_RPC_URL=REPLACE_WITH_DEDICATED_ROBINHOOD_DRPC_URL
ROBINHOOD_ALCHEMY_RPC_URL=REPLACE_WITH_DEDICATED_ROBINHOOD_ALCHEMY_URL
ROBINHOOD_SCAN_PROVIDER=drpc
ROBINHOOD_DISCOVERY_SCAN_PROVIDER=drpc
ROBINHOOD_HEAD_PROVIDER=public
ROBINHOOD_BACKFILL_START_BLOCK=REPLACE_WITH_DECLARED_START_BLOCK

# Conservative canary. Scale only after observing lag, errors, DB and disk.
ROBINHOOD_BACKFILL_DISCOVERY_ENABLED=true
ROBINHOOD_BACKFILL_SHADOW_ENABLED=true
ROBINHOOD_BACKFILL_ENRICHMENT_ENABLED=true
ROBINHOOD_BACKFILL_FINALIZER_ENABLED=true
ROBINHOOD_BACKFILL_AGGREGATION_ENABLED=true
ROBINHOOD_SCAN_RANGE_SIZE=10000
ROBINHOOD_SCAN_IN_FLIGHT_RANGES=1
ROBINHOOD_DISCOVERY_SCAN_MAX_RANGES_PER_POLL=1
ROBINHOOD_BACKFILL_ENRICHMENT_CLAIM_SIZE=100
ROBINHOOD_BACKFILL_AGGREGATION_CLAIM_SIZE=10000
ROBINHOOD_BACKFILL_AGGREGATION_TOKEN_LIMIT=25
ROBINHOOD_RPC_BATCH_SIZE=100

# Alchemy assists only timestamp reads; usage is monitored manually in its dashboard.
ROBINHOOD_USE_ALCHEMY=false
ROBINHOOD_BACKFILL_ALCHEMY_TIMESTAMPS_ENABLED=true
