# Install as /etc/trendscope/fomo-browser.env, replace paths only when needed,
# keep root:root mode 0600, and never commit browser credentials or profile data.

FOMO_BROWSER_CHROME_PATH=/usr/bin/google-chrome-stable
FOMO_BROWSER_PROFILE_DIR=/var/lib/fomo-browser/profile
FOMO_BROWSER_CDP_PORT=9222
FOMO_BROWSER_START_URL=https://fomo.family/tokens/robinhood/0x39dbed3a2bd333467115de45665cc57f813c4571
