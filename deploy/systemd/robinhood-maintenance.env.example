# Install as /etc/volume-bot-alert/robinhood-maintenance.env, replace REPLACE_* values,
# keep mode 0600, and never commit the populated file.

PORT=3011
RUN_SOCKET_HUB=false
RUN_BACKGROUND_JOBS=true
BACKGROUND_WORKER_GROUPS=robinhood-maintenance

JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET
DATABASE_URL=REPLACE_WITH_PRIVATE_POSTGRESQL_URL

# Start disabled. Enable only after the watermark/dry-run gate is approved.
ROBINHOOD_RETENTION_ENABLED=false
# ROBINHOOD_MARKET_AGGREGATE_VERIFIED_FROM=REPLACE_WITH_UTC_DAY_BOUNDARY
# ROBINHOOD_MARKET_AGGREGATE_VERIFIED_THROUGH=REPLACE_WITH_UTC_DAY_BOUNDARY

# Defense in depth: no ingestion or product automation belongs to this process.
ROBINHOOD_INGESTION_ENABLED=false
ROBINHOOD_TRANSPORT_ENABLED=false
ROBINHOOD_PERSISTENCE_ENABLED=false
ROBINHOOD_ALERTS_ENABLED=false
MOCK_TRADING_ENABLED=false
MOCK_TRADING_TAKE_PROFIT_ENABLED=false
