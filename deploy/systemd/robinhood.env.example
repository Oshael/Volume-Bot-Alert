# Copy to /etc/volume-bot-alert/robinhood.env, replace every REPLACE_* value,
# keep mode 0600, and never commit the populated file.

PORT=3004
RUN_SOCKET_HUB=false
RUN_BACKGROUND_JOBS=true
BACKGROUND_WORKER_GROUPS=robinhood

JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET
DATABASE_URL=REPLACE_WITH_PRIVATE_POSTGRESQL_URL

ROBINHOOD_INGESTION_ENABLED=true
ROBINHOOD_TRANSPORT_ENABLED=true
ROBINHOOD_PERSISTENCE_ENABLED=true
ROBINHOOD_ALERTS_ENABLED=false
ROBINHOOD_USER_VISIBILITY_ENABLED=false

ROBINHOOD_RPC_URL=http://127.0.0.1:8547
ROBINHOOD_USE_ALCHEMY=false
ROBINHOOD_START_BLOCK=REPLACE_WITH_FRESH_MARKET_ENRICHED_NEXT_BLOCK
ROBINHOOD_MARKET_LOG_FILTER_MODE=topics-only

# Keep false until robinhood:wallet-live-bootstrap completes successfully.
ROBINHOOD_WALLET_SWAP_LIVE_ENABLED=false
ROBINHOOD_WALLET_SWAP_LIVE_INTERVAL_MS=2000
ROBINHOOD_WALLET_SWAP_LIVE_MAX_ERROR_BACKOFF_MS=30000
ROBINHOOD_WALLET_SWAP_LIVE_MAX_BLOCKS_PER_TICK=200
ROBINHOOD_WALLET_SWAP_LIVE_REORG_DEPTH=12
ROBINHOOD_WALLET_SWAP_LIVE_MAX_CONSECUTIVE_FAILURES=5

ROBINHOOD_SOCIAL_METADATA_ENABLED=false
ROBINHOOD_MARKET_AGGREGATES_ENABLED=true
ROBINHOOD_MARKET_AGGREGATE_READS_ENABLED=false
