# Install as /etc/trendscope/robinhood-canonical-liquidity.env, replace REPLACE_* values,
# keep root:root mode 0600, and never commit the populated file.

ROBINHOOD_CANONICAL_LIQUIDITY_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=volume_alert
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_SSL=REPLACE_TRUE_OR_FALSE
DB_POOL_MAX=10

# Permanent pruned node on the VPS. Archive access is not used by this worker.
ROBINHOOD_CANONICAL_LIQUIDITY_RPC_URL=http://127.0.0.1:8547
ROBINHOOD_CANONICAL_LIQUIDITY_RPC_TIMEOUT_MS=5000

ROBINHOOD_CANONICAL_LIQUIDITY_SCAN_BLOCKS=1000
ROBINHOOD_CANONICAL_LIQUIDITY_SCAN_RANGES=20
ROBINHOOD_CANONICAL_LIQUIDITY_REFRESH_BATCH_SIZE=100
ROBINHOOD_CANONICAL_LIQUIDITY_CONCURRENCY=10
ROBINHOOD_CANONICAL_LIQUIDITY_MAX_ANCHOR_LAG_BLOCKS=128
ROBINHOOD_CANONICAL_LIQUIDITY_CLAIM_LEASE_MS=600000
ROBINHOOD_CANONICAL_LIQUIDITY_RETRY_BASE_MS=5000
ROBINHOOD_CANONICAL_LIQUIDITY_RETRY_MAX_MS=60000
ROBINHOOD_CANONICAL_LIQUIDITY_IDLE_POLL_MS=1000
ROBINHOOD_CANONICAL_LIQUIDITY_ERROR_POLL_MS=5000
ROBINHOOD_CANONICAL_LIQUIDITY_LEASE_HEARTBEAT_MS=30000
ROBINHOOD_CANONICAL_LIQUIDITY_LEASE_TTL_MS=120000
